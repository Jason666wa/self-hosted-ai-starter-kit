# ------------------------------------------------------------------
# n8n 223 生产机部署环境变量（10.10.10.223）
# 拓扑: 浏览器 / 平台 SSO -> http://10.10.10.223:5678
# 用法:
#   1) 复制本文件为 .env（若还没有）并填写密钥（勿留空 / CHANGE_ME）
#   2) N8N_SSO_JWT_SECRET 必须与 electromagnify-ui/production/223/.env 相同
#   3) bash load-and-up.sh
# ------------------------------------------------------------------

POSTGRES_USER=root
POSTGRES_PASSWORD=
POSTGRES_DB=n8n

N8N_ENCRYPTION_KEY=
N8N_USER_MANAGEMENT_JWT_SECRET=
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# Silence 2.x→3.x deprecation warnings
N8N_MIGRATE_FS_STORAGE_PATH=true
N8N_UNVERIFIED_PACKAGES_ENABLED=true
N8N_RUNNERS_TASK_TIMEOUT=300
N8N_COMPRESSION_NODE_MAX_DECOMPRESSED_SIZE_BYTES=2147483648
N8N_COMPRESSION_NODE_MAX_ZIP_ENTRIES=5000

# External task runners（n8n 与 n8n-runners 共享）
N8N_RUNNERS_AUTH_TOKEN=

# 宿主机端口（与 223 上其它服务错开）
N8N_PORT=5678
QDRANT_PORT=6333

# 对外访问地址（Webhook / Public Chat / Form；未设会落成 localhost）
N8N_HOST=10.10.10.223
N8N_PROTOCOL=http
WEBHOOK_URL=http://10.10.10.223:5678/

# 可选：指向宿主机或其它机器上的 Ollama；不需要可留空
# OLLAMA_HOST=host.docker.internal:11434

# Electromagnify SSO（与 electromagnify-ui/production/223/.env 的 N8N_SSO_* 同值）
N8N_SSO_JWT_SECRET=
N8N_SSO_ISS=electromagnify
N8N_SSO_AUD=n8n-editor
N8N_SSO_DEFAULT_ROLE=global:member
N8N_SSO_LANDING_PATH=/home
N8N_EDITOR_BASE_URL=http://10.10.10.223:5678
EXTERNAL_HOOK_FILES=/home/node/.n8n/emagy-sso-hooks.js
